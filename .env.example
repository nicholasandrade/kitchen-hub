# Keep this file on the server or tablet. Never expose the key through VITE_* variables.
OPENAI_API_KEY=your_api_key_here

# Optional model overrides
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_COMMAND_MODEL=gpt-5-mini
VOICE_SERVER_PORT=8787
KITCHEN_HUB_WAKE_PHRASE=Kitchen Hub

# Google Calendar (read-only). Create a Desktop OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Optional. The default is http://127.0.0.1:8787
GOOGLE_REDIRECT_URI=
