{
  "name": "kitchen-hub",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\Start-KitchenHubLanDev.ps1",
    "voice-server": "node server/index.mjs",
    "wake-listener": ".venv-wake\\Scripts\\python.exe wake\\listener.py",
    "wake-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File wake\\setup.ps1",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging\\build-windows.ps1",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "html-to-image": "^1.11.13",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
